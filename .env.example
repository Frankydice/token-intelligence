# Token Intelligence & Sniper Configuration
# =======================================================
# SECURITY WARNING: NEVER COMMIT SENSITIVE PRIVATE KEYS OR PRODUCTION SECRETS!

# Application Mode: 'demo' or 'live'
VITE_APP_MODE=demo

# Discovery & DEX Providers
VITE_DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex
VITE_PUMPFUN_API_URL=https://frontend-api.pump.fun
VITE_GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2

# RPC Endpoints (Public fallbacks provided; supply dedicated RPCs for production execution)
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# AI Analysis (Optional: Gemini API Key for on-chain summary & narrative breakdown)
VITE_GEMINI_API_KEY=

# Execution Guardrails (Enforced by client & execution provider)
VITE_MAX_POSITION_SIZE_USD=500
VITE_MAX_DAILY_LOSS_USD=1000
VITE_MAX_CONCURRENT_POSITIONS=3
VITE_MAX_SLIPPAGE_BPS=300
